{
  "doctype": "DocType",
  "name": "Doctor Profile",
  "module": "MR Force",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "autoname": "format:DOC-.#####",
  "title_field": "doctor_name",
  "track_changes": 1,
  "allow_rename": 1,
  "fields": [
    {
      "label": "Doctor Name",
      "fieldname": "doctor_name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "label": "Specialty",
      "fieldname": "specialty",
      "fieldtype": "Link",
      "options": "Doctor Specialty"
    },
    {
      "label": "Territory",
      "fieldname": "territory",
      "fieldtype": "Link",
      "options": "Territory Coverage"
    },
    {
      "label": "Clinic Name",
      "fieldname": "clinic_name",
      "fieldtype": "Data"
    },
    {
      "label": "Mobile No",
      "fieldname": "mobile_no",
      "fieldtype": "Data"
    },
    {
      "label": "Email",
      "fieldname": "email",
      "fieldtype": "Data",
      "options": "Email"
    },
    {
      "label": "Address",
      "fieldname": "address",
      "fieldtype": "Small Text"
    },
    {
      "label": "Latitude",
      "fieldname": "latitude",
      "fieldtype": "Float"
    },
    {
      "label": "Longitude",
      "fieldname": "longitude",
      "fieldtype": "Float"
    },
    {
      "label": "Visit Frequency",
      "fieldname": "visit_frequency",
      "fieldtype": "Select",
      "options": "Weekly\nFortnightly\nMonthly\nQuarterly",
      "default": "Monthly"
    },
    {
      "label": "Preferred Visit Time",
      "fieldname": "preferred_visit_time",
      "fieldtype": "Time"
    },
    {
      "label": "Status",
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Active\nInactive",
      "default": "Active"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "share": 1
    },
    {
      "role": "MR Force Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "share": 1
    },
    {
      "role": "Medical Representative",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "engine": "InnoDB"
}
