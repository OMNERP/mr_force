{
  "doctype": "DocType",
  "name": "Pharmacy Profile",
  "module": "MR Force",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "autoname": "format:PHARM-.#####",
  "title_field": "pharmacy_name",
  "track_changes": 1,
  "allow_rename": 1,
  "fields": [
    {
      "label": "Pharmacy Name",
      "fieldname": "pharmacy_name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "label": "Territory",
      "fieldname": "territory",
      "fieldtype": "Link",
      "options": "Territory Coverage"
    },
    {
      "label": "Contact Person",
      "fieldname": "contact_person",
      "fieldtype": "Data"
    },
    {
      "label": "Mobile No",
      "fieldname": "mobile_no",
      "fieldtype": "Data"
    },
    {
      "label": "Address",
      "fieldname": "address",
      "fieldtype": "Small Text"
    },
    {
      "label": "Latitude",
      "fieldname": "latitude",
      "fieldtype": "Float"
    },
    {
      "label": "Longitude",
      "fieldname": "longitude",
      "fieldtype": "Float"
    },
    {
      "label": "Engagement Level",
      "fieldname": "engagement_level",
      "fieldtype": "Select",
      "options": "High\nMedium\nLow",
      "default": "Medium"
    },
    {
      "label": "Status",
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Active\nInactive",
      "default": "Active"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "share": 1
    },
    {
      "role": "MR Force Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "share": 1
    },
    {
      "role": "Medical Representative",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "engine": "InnoDB"
}
