{
  "doctype": "DocType",
  "name": "Doctor Visit",
  "module": "MR Force",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "autoname": "format:VISIT-.#####",
  "title_field": "doctor",
  "track_changes": 1,
  "allow_rename": 1,
  "fields": [
    {
      "label": "Doctor",
      "fieldname": "doctor",
      "fieldtype": "Link",
      "options": "Doctor Profile",
      "reqd": 1
    },
    {
      "label": "Medical Representative",
      "fieldname": "medical_representative",
      "fieldtype": "Link",
      "options": "Medical Representative",
      "reqd": 1
    },
    {
      "label": "Visit Datetime",
      "fieldname": "visit_datetime",
      "fieldtype": "Datetime",
      "reqd": 1
    },
    {
      "label": "Visit Date",
      "fieldname": "visit_date",
      "fieldtype": "Date",
      "read_only": 1
    },
    {
      "label": "Activity Type",
      "fieldname": "activity_type",
      "fieldtype": "Link",
      "options": "Activity Type"
    },
    {
      "label": "Status",
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Planned\nIn Progress\nCompleted\nMissed\nCancelled",
      "default": "Planned"
    },
    {
      "label": "Latitude",
      "fieldname": "latitude",
      "fieldtype": "Float"
    },
    {
      "label": "Longitude",
      "fieldname": "longitude",
      "fieldtype": "Float"
    },
    {
      "label": "Checkin",
      "fieldname": "checkin",
      "fieldtype": "Link",
      "options": "Geo Checkin"
    },
    {
      "label": "Next Follow Up Date",
      "fieldname": "next_follow_up_date",
      "fieldtype": "Date"
    },
    {
      "label": "Notes",
      "fieldname": "notes",
      "fieldtype": "Text Editor"
    },
    {
      "label": "Feedback",
      "fieldname": "feedback",
      "fieldtype": "Table",
      "options": "Visit Feedback"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "share": 1
    },
    {
      "role": "MR Force Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "share": 1
    },
    {
      "role": "Medical Representative",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "report": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "engine": "InnoDB"
}
